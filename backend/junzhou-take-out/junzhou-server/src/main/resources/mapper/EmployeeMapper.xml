<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.junzhou.mapper.EmployeeMapper">
    <select id="pageQuery" resultType="com.junzhou.entity.Employee">
        <bind name="_tenant" value="@com.junzhou.context.RequestScope@requireEmployeeTenantId()"/>
        select id, tenant_id, name, username, '****' as password, phone, sex, id_number,
               status, create_time, update_time, create_user, update_user from employee
        <where>
            tenant_id=#{_tenant}
            <if test="name != null and name != ''">
                and name like concat('%',#{name},'%')
            </if>
        </where>
        order by create_time desc
    </select>

    <update id="update" parameterType="com.junzhou.entity.Employee">
        <bind name="_tenant" value="@com.junzhou.context.RequestScope@requireEmployeeTenantId()"/>
        update employee
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="username != null">
                username = #{username},
            </if>
            <if test="password != null">
                password = #{password},
            </if>
            <if test="phone != null">
                phone = #{phone},
            </if>
            <if test="sex != null">
                sex = #{sex},
            </if>
            <if test="idNumber != null">
                id_number = #{idNumber},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateUser != null">
                update_user = #{updateUser},
            </if>
        </set>
        where id = #{id} and tenant_id=#{_tenant}
    </update>

</mapper>
