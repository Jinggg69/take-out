<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.junzhou.mapper.ShoppingCartMapper">

    <select id="list" resultType="com.junzhou.entity.ShoppingCart">
        <bind name="scopeTenant" value="@com.junzhou.context.RequestScope@requireTenantId()"/><bind name="scopeStore" value="@com.junzhou.context.RequestScope@requireStoreId()"/><bind name="scopeUser" value="@com.junzhou.context.RequestScope@requireUserId()"/>
        select * from shopping_cart
        <where>
            user_id = #{userId} and user_id = #{scopeUser} and tenant_id = #{scopeTenant} and store_id = #{scopeStore}
            <if test="dishId != null">
                and dish_id = #{dishId} and setmeal_id is null
            </if>
            <if test="setmealId != null">
                and setmeal_id = #{setmealId} and dish_id is null
            </if>
        </where>
        order by id
    </select>
</mapper>
