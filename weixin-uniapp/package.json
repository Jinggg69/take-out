{
  "name": "junzhou-ordering-miniapp",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev:mp-weixin": "node scripts/uni.mjs -p mp-weixin",
    "build:mp-weixin": "node scripts/uni.mjs build -p mp-weixin && node scripts/check-mp-artifact.mjs",
    "dev:h5": "node scripts/uni.mjs -p h5 --host 127.0.0.1",
    "build:h5": "node scripts/uni.mjs build -p h5",
    "test": "node --test tests/*.test.cjs components/app-discovery/screens.test.cjs",
    "test:ui": "npm run build:h5 && node tests/e2e-smoke.mjs",
    "check": "npm test && npm run build:mp-weixin && npm run build:h5"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030620261106001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030620261106001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030620261106001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030620261106001",
    "@dcloudio/uni-ui": "1.4.14",
    "dayjs": "1.11.13",
    "pinia": "2.2.0",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030620261106001",
    "@vue/compiler-sfc": "3.4.21",
    "playwright": "1.65.0",
    "sass": "1.77.8",
    "vite": "5.2.8"
  }
}
