{
  "name": "junzhou-admin-vue3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run type-check && vite build",
    "build:uat": "npm run type-check && vite build --mode production.uat",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "node --test tests/*.test.ts",
    "test:proxy": "node --test tests/proxy.integration.ts",
    "check": "npm run lint && npm run test:unit && npm run test:proxy && npm run build"
  },
  "dependencies": {
    "axios": "1.20.0",
    "element-plus": "2.14.7",
    "js-cookie": "3.0.8",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "sass": "1.106.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
