.navBar{position:fixed;display:flex;z-index:9;top:0;left:0;height:160rpx;width:100vw;box-sizing:border-box;height:304rpx;opacity:1;background:linear-gradient(184deg,rgba(0,0,0,.35) 25%,rgba(51,51,51,0) 96%)}.navBar .leftNav .back{width:88rpx;height:88rpx}.navBar .centerNav{width:calc(100vw - 176rpx);text-align:center;line-height:88rpx;font-size:36rpx;color:#fff}.navBar .logo{height:66rpx;width:184rpx}.navBar .index_bg{width:750rpx;height:304rpx}.navBar .test_image{height:56rpx;width:56rpx}.navBar .person-box{position:fixed;left:38rpx;z-index:9999;top:100rpx;display:flex;align-items:center}.navBar .person-title{flex:1;height:36rpx;font-size:26rpx;font-family:PingFangSC,PingFangSC-Medium;font-weight:500;text-align:left;color:#fff;line-height:36rpx;letter-spacing:0;margin-left:14rpx}.brand-navbar{height:calc(280rpx + 25px);background:linear-gradient(135deg,#75191e,#9e2026 65%,#b23a32);pointer-events:none;overflow:hidden}.brand-navbar .person-box{pointer-events:auto;left:30rpx;height:32px;min-width:180rpx;max-width:calc(100vw - 140px);margin-top:-5px;padding:0 12rpx;border-radius:32rpx;background:rgba(48,40,36,.22);box-sizing:border-box}.brand-navbar .test_image{width:36rpx;height:36rpx;flex-shrink:0}.brand-navbar .person-title{margin-left:10rpx;font-size:24rpx;white-space:nowrap;color:#fff8ee}.brand-navbar .brand-scenery{position:absolute;left:0;right:0;bottom:0;height:210rpx}.brand-navbar .brand-dam{position:absolute;right:35rpx;bottom:150rpx;width:370rpx;height:84rpx;border-top:6rpx solid rgba(201,164,92,.4);border-bottom:5rpx solid rgba(201,164,92,.3);background:repeating-linear-gradient(90deg,transparent,transparent 32rpx,rgba(201,164,92,.28) 0,rgba(201,164,92,.28) 40rpx);-webkit-transform:skewX(-8deg);transform:skewX(-8deg)}.brand-navbar .brand-dam::before, .brand-navbar .brand-dam::after{content:"";position:absolute;top:-30rpx;width:26rpx;height:30rpx;border:4rpx solid rgba(201,164,92,.4)}.brand-navbar .brand-dam::before{left:18rpx}.brand-navbar .brand-dam::after{right:18rpx}.brand-navbar .brand-water{position:absolute;width:900rpx;height:150rpx;border:2rpx solid rgba(201,164,92,.28);border-radius:50%}.brand-navbar .water-back{left:-100rpx;bottom:20rpx;-webkit-transform:rotate(-5deg);transform:rotate(-5deg)}.brand-navbar .water-front{left:-40rpx;bottom:0;-webkit-transform:rotate(6deg);transform:rotate(6deg)}.brand-navbar .brand-fish{position:absolute;left:78rpx;bottom:198rpx;width:56rpx;height:22rpx;border:2rpx solid rgba(201,164,92,.5);border-radius:50%;-webkit-transform:rotate(-22deg);transform:rotate(-22deg)}.brand-navbar .brand-fish::after{content:"";position:absolute;left:-16rpx;top:1rpx;border-top:10rpx solid transparent;border-bottom:10rpx solid transparent;border-left:16rpx solid rgba(201,164,92,.5)}